{
  "name": "@acme/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/main.ts",
    "start": "node --env-file-if-exists=../.env src/main.ts",
    "migrate": "node --env-file-if-exists=../.env src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "hash-password": "node src/hash-password.ts",
    "seed": "node --env-file-if-exists=../.env src/seed/cli.ts"
  },
  "dependencies": {
    "@acme/shared": "*",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
