# Copy to .env and fill in. .env is git-ignored; never commit secrets.
DATABASE_URL=postgres://acme:acme@localhost:4734/acme
TEST_DATABASE_URL=postgres://acme:acme@localhost:4734/acme_test
# scrypt hash: run `npm run hash-password`, type the password, press Enter
APP_PASSWORD_HASH=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Primary free model; the final choice comes from the smoke test
OPENROUTER_MODEL=
# Up to two comma-separated fallbacks: OpenRouter takes at most three models in all
OPENROUTER_FALLBACK_MODELS=
